DOMAIN=api.your-domain.example
PORT=8081
HOST=0.0.0.0
DATA_DIR=./data
TRUST_PROXY_HEADERS=false

# Set unique values before starting the server with a new database. Admin passwords must be 12-128 characters.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# Optional one-time setup key when creating the first admin through the setup screen.
INITIAL_ADMIN_KEY=
TOKEN_ENCRYPTION_KEY=

# Set to a currently supported Meta Graph API version before sending WhatsApp messages.
META_GRAPH_VERSION=
