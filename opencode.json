{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "./gradlew *": "allow",
      "deno *": "allow",
      "node *": "allow",
      "npm install --prefix .local-tools*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "ls*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "diff *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "sed -n*": "allow",
      "git show*": "allow",
      "git grep*": "allow",
      "git ls-files*": "allow",
      "git tag -l*": "allow",
      "./tools/check.sh*": "ask",
      "graphify query*": "allow",
      "graphify path*": "allow",
      "graphify explain*": "allow",
      "graphify update*": "allow",
      "unzip -l*": "allow",
      "pwd": "allow",
      "echo *": "allow",
      "rm *": "ask",
      "gh *": "ask",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git branch -D*": "deny",
      "git clean*": "deny",
      "git rebase*": "deny",
      "supabase db push*": "deny",
      "supabase functions deploy*": "deny",
      "supabase migration repair*": "deny",
      "find * -delete*": "deny",
      "find * -exec*": "deny",
      "find * -execdir*": "deny"
    },
    "skill": {
      "speckit-*": "deny",
      "to-spec": "deny",
      "to-tickets": "deny",
      "take-ticket": "deny"
    }
  }
}
