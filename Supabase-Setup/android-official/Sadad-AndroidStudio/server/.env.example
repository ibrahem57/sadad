DOMAIN=api.your-domain.example
PORT=8080
HOST=0.0.0.0
DATA_DIR=./data
TRUST_PROXY_HEADERS=false

# Set unique credentials before deployment. The initial password must be 12-128 characters.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# Optional one-time key for creating the first admin from the setup screen when the credentials above are blank.
INITIAL_ADMIN_KEY=
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS_FROM_openssl_rand_-hex_32

# Set to a currently supported Meta Graph API version before sending WhatsApp messages.
META_GRAPH_VERSION=
